---
interface Props {
  /** Optional attribution shown beneath the quote */
  cite?: string;
}

const { cite } = Astro.props;
---

<aside class="pullquote">
  <p><slot /></p>
  {cite && <cite class="pullquote-cite">— {cite}</cite>}
</aside>

<style>
  .pullquote {
    margin: 2em 0;
    padding: 0.25em 0 0.25em 1.25rem;
    border-left: 2px solid var(--accent);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.35rem;
    line-height: 1.4;
    color: var(--ink);
    letter-spacing: -0.005em;
  }
  .pullquote p { margin: 0; }
  .pullquote-cite {
    display: block;
    margin-top: 0.5em;
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }

  @media (min-width: 720px) {
    .pullquote {
      font-size: 1.55rem;
      margin: 2.25em -1rem 2.25em -1rem;
      padding: 0.25em 0 0.25em 2rem;
    }
  }
</style>
