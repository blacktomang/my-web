---
import BaseLayout from '../layouts/BaseLayout.astro';
import Compass from '../components/marks/Compass.astro';
import { getCollection, render } from 'astro:content';

const formatRoleDate = (date: Date) => date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
});

const experienceEntries = (await getCollection('experience'))
  .sort((a, b) => {
    const currentFirst = Number(!b.data.endedAt) - Number(!a.data.endedAt);
    return currentFirst || b.data.startedAt.valueOf() - a.data.startedAt.valueOf();
  });

const roles = await Promise.all(experienceEntries.map(async entry => ({
  ...entry.data,
  Content: (await render(entry)).Content,
})));
---

<BaseLayout title="Work | Syamsul Arifin">
  <Compass />
  <h1 class="page-title">Work</h1>

  <p class="lede">
    Five years building things across the stack.
    A short version follows; ask for details over email.
  </p>

  {roles.map(role => (
    <section class="role">
      <h2>{role.company} <span class="muted">/ {role.role}</span></h2>
      <p class="meta">
        {formatRoleDate(role.startedAt)} to {role.endedAt ? formatRoleDate(role.endedAt) : 'present'}
        {role.context && ` · ${role.context}`}
      </p>
      <role.Content />
    </section>
  ))}

  <p class="contact meta">
    For longer conversations:
    <a href="mailto:arifprojects76@gmail.com">arifprojects76@gmail.com</a>
  </p>
</BaseLayout>

<style>
  .page-title { margin-top: var(--space-lg); }
  .lede { color: var(--ink-soft); margin-bottom: var(--space-xl); }
  .role + .role { margin-top: var(--space-lg); }
  .role h2 {
    font-size: 1.2rem;
    margin: 0;
    font-weight: 500;
  }
  .role .muted {
    color: var(--ink-soft);
    font-weight: 400;
  }
  .role .meta {
    margin: 0.25em 0 0.75em;
  }
  .contact {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--rule);
  }
</style>
